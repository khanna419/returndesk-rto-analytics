{
  "name": "ReturnDesk",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-US",
    "expressions": [
      {
        "name": "DataFolder",
        "kind": "m",
        "expression": "\"\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=false]"
      }
    ],
    "tables": [
      {
        "name": "History",
        "columns": [
          {
            "name": "Shipment",
            "dataType": "string",
            "sourceColumn": "id",
            "summarizeBy": "none"
          },
          {
            "name": "Cohort date",
            "dataType": "dateTime",
            "sourceColumn": "date",
            "summarizeBy": "none",
            "formatString": "dd MMM yyyy"
          },
          {
            "name": "Courier",
            "dataType": "string",
            "sourceColumn": "courier",
            "summarizeBy": "none"
          },
          {
            "name": "City",
            "dataType": "string",
            "sourceColumn": "city",
            "summarizeBy": "none"
          },
          {
            "name": "PIN code",
            "dataType": "string",
            "sourceColumn": "pin",
            "summarizeBy": "none"
          },
          {
            "name": "Payment",
            "dataType": "string",
            "sourceColumn": "payment",
            "summarizeBy": "none"
          },
          {
            "name": "Failure reason",
            "dataType": "string",
            "sourceColumn": "reason",
            "summarizeBy": "none"
          },
          {
            "name": "Outcome",
            "dataType": "string",
            "sourceColumn": "outcome",
            "summarizeBy": "none"
          },
          {
            "name": "Attempts",
            "dataType": "int64",
            "sourceColumn": "attempts",
            "summarizeBy": "none"
          },
          {
            "name": "Order value",
            "dataType": "int64",
            "sourceColumn": "value",
            "summarizeBy": "none"
          },
          {
            "name": "Merchant",
            "dataType": "string",
            "sourceColumn": "merchant",
            "summarizeBy": "none"
          },
          {
            "name": "State",
            "dataType": "string",
            "sourceColumn": "state",
            "summarizeBy": "none"
          },
          {
            "name": "Resolved at",
            "dataType": "dateTime",
            "sourceColumn": "resolvedAt",
            "summarizeBy": "none",
            "formatString": "dd MMM yyyy HH:mm"
          },
          {
            "name": "Created at",
            "dataType": "dateTime",
            "sourceColumn": "createdAt",
            "summarizeBy": "none",
            "formatString": "dd MMM yyyy HH:mm"
          },
          {
            "name": "Week starting",
            "dataType": "dateTime",
            "sourceColumn": "WeekStart",
            "summarizeBy": "none",
            "formatString": "dd MMM yyyy"
          }
        ],
        "partitions": [
          {
            "name": "History",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Encoded = Text.Combine({\"\", \"\", \"\", \"\", \"\", \"\", \"\", \"\", \"\", \"\", \"\", \"\", \"\", \"\", \"\", \"\", \"\", \"\", \"\", \"\"}),",
                "    Bytes = if DataFolder = \"\" then Binary.Decompress(Binary.FromText(Encoded, BinaryEncoding.Base64), Compression.GZip) else File.Contents(DataFolder & \"/history.csv\"),",
                "    CsvData = Csv.Document(Bytes, [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(CsvData, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"id\", type text}, {\"date\", type date}, {\"courier\", type text}, {\"city\", type text}, {\"pin\", type text}, {\"payment\", type text}, {\"reason\", type text}, {\"outcome\", type text}, {\"attempts\", Int64.Type}, {\"value\", Int64.Type}, {\"merchant\", type text}, {\"state\", type text}, {\"resolvedAt\", type datetime}, {\"createdAt\", type datetime}}, \"en-US\")",
                ",    Weekly = Table.AddColumn(Typed, \"WeekStart\", each Date.StartOfWeek([date], Day.Monday), type date)",
                "in",
                "    Weekly"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Resolved failures",
            "expression": "COUNTROWS('History')",
            "formatString": "#,0"
          },
          {
            "name": "Returned",
            "expression": "CALCULATE([Resolved failures], KEEPFILTERS('History'[Outcome] = \"RTO\")) + 0",
            "formatString": "#,0"
          },
          {
            "name": "Recovered",
            "expression": "CALCULATE([Resolved failures], KEEPFILTERS('History'[Outcome] = \"Recovered\")) + 0",
            "formatString": "#,0"
          },
          {
            "name": "RTO rate",
            "expression": "DIVIDE([Returned], [Resolved failures])",
            "formatString": "0.0%"
          },
          {
            "name": "Recovery rate",
            "expression": "DIVIDE([Recovered], [Resolved failures])",
            "formatString": "0.0%"
          }
        ]
      },
      {
        "name": "Queue",
        "columns": [
          {
            "name": "Shipment",
            "dataType": "string",
            "sourceColumn": "id",
            "summarizeBy": "none"
          },
          {
            "name": "Last failure date",
            "dataType": "dateTime",
            "sourceColumn": "date",
            "summarizeBy": "none",
            "formatString": "dd MMM yyyy"
          },
          {
            "name": "Courier",
            "dataType": "string",
            "sourceColumn": "courier",
            "summarizeBy": "none"
          },
          {
            "name": "City",
            "dataType": "string",
            "sourceColumn": "city",
            "summarizeBy": "none"
          },
          {
            "name": "PIN code",
            "dataType": "string",
            "sourceColumn": "pin",
            "summarizeBy": "none"
          },
          {
            "name": "Payment",
            "dataType": "string",
            "sourceColumn": "payment",
            "summarizeBy": "none"
          },
          {
            "name": "Failure reason",
            "dataType": "string",
            "sourceColumn": "reason",
            "summarizeBy": "none"
          },
          {
            "name": "Attempts",
            "dataType": "int64",
            "sourceColumn": "attempts",
            "summarizeBy": "none"
          },
          {
            "name": "Order value",
            "dataType": "int64",
            "sourceColumn": "value",
            "summarizeBy": "none"
          },
          {
            "name": "Last attempt",
            "dataType": "dateTime",
            "sourceColumn": "lastAttempt",
            "summarizeBy": "none",
            "formatString": "dd MMM yyyy HH:mm"
          },
          {
            "name": "Hours open",
            "dataType": "int64",
            "sourceColumn": "hoursOpen",
            "summarizeBy": "none"
          },
          {
            "name": "Priority",
            "dataType": "string",
            "sourceColumn": "priority",
            "summarizeBy": "none"
          },
          {
            "name": "Next action",
            "dataType": "string",
            "sourceColumn": "action",
            "summarizeBy": "none"
          },
          {
            "name": "Priority reason",
            "dataType": "string",
            "sourceColumn": "why",
            "summarizeBy": "none"
          },
          {
            "name": "Rank",
            "dataType": "int64",
            "sourceColumn": "rank",
            "summarizeBy": "none"
          },
          {
            "name": "Merchant",
            "dataType": "string",
            "sourceColumn": "merchant",
            "summarizeBy": "none"
          },
          {
            "name": "State",
            "dataType": "string",
            "sourceColumn": "state",
            "summarizeBy": "none"
          },
          {
            "name": "Created at",
            "dataType": "dateTime",
            "sourceColumn": "createdAt",
            "summarizeBy": "none",
            "formatString": "dd MMM yyyy HH:mm"
          },
          {
            "name": "Hours since attempt",
            "dataType": "int64",
            "sourceColumn": "hoursSinceLast",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Queue",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Encoded = Text.Combine({\"\"}),",
                "    Bytes = if DataFolder = \"\" then Binary.Decompress(Binary.FromText(Encoded, BinaryEncoding.Base64), Compression.GZip) else File.Contents(DataFolder & \"/queue.csv\"),",
                "    CsvData = Csv.Document(Bytes, [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(CsvData, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"id\", type text}, {\"date\", type date}, {\"courier\", type text}, {\"city\", type text}, {\"pin\", type text}, {\"payment\", type text}, {\"reason\", type text}, {\"attempts\", Int64.Type}, {\"value\", Int64.Type}, {\"lastAttempt\", type datetime}, {\"hoursOpen\", Int64.Type}, {\"priority\", type text}, {\"action\", type text}, {\"why\", type text}, {\"rank\", Int64.Type}, {\"merchant\", type text}, {\"state\", type text}, {\"createdAt\", type datetime}, {\"hoursSinceLast\", Int64.Type}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Eligible cases",
            "expression": "COUNTROWS('Queue')",
            "formatString": "#,0"
          },
          {
            "name": "In first 50",
            "expression": "CALCULATE([Eligible cases], KEEPFILTERS('Queue'[Rank] <= 50)) + 0",
            "formatString": "#,0"
          },
          {
            "name": "High priority",
            "expression": "CALCULATE([Eligible cases], KEEPFILTERS('Queue'[Priority] = \"High\")) + 0",
            "formatString": "#,0"
          },
          {
            "name": "Median hours since attempt",
            "expression": "MEDIAN('Queue'[Hours since attempt])",
            "formatString": "#,0.0"
          }
        ]
      }
    ]
  }
}
